<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-MENBM6GSNY"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag("js", new Date());
    gtag("config", "G-MENBM6GSNY");
  </script>

  <title>Effing Worms</title>

  <!-- Waflash Style -->
  <link 
    rel="stylesheet" 
    href="https://cdn.jsdelivr.net/gh/7DatsonBack/3kh0-Assets@60f2f97b00ffe9566ee06c82ecaf67255931118b/Run%202/waflash/waflash-style.css" 
    type="text/css"
  >

  <!-- Game Config -->
  <script>
    var gameConfig = {
      swfUrl: "https://cdn.jsdelivr.net/gh/jackilyna/reshade@8909216e53040b9b8facf8fe7a58d202a0dcd628/res/core.swf"
    };
  </script>
</head>

<body>
  <div id="waflashContainer">
    <canvas class="waflashCanvas" id="canvas" tabindex="1"></canvas>
    <div id="waflashStatus" style="display: none;">Playing...</div>
  </div>

  <!-- Internet Explorer detection -->
  <script>
    var ua = navigator.userAgent.toLowerCase();
    if (
      (navigator.appName == 'Netscape' && ua.indexOf('trident') != -1) ||
      (ua.indexOf("msie") != -1)
    ) {
      var waf = document.getElementById('waflashStatus');
      waf.style.display = 'block';
      waf.innerText = 'Internet Explorer is not supported.\nPlease use a modern browser.';
      gtag('event', 'connect_from_ie', {
        event_category: 'error',
        event_label: ua
      });
    }
  </script>

  <!-- Waflash Player -->
  <script type="module" crossorigin="anonymous">
    // Check if user is on mobile
    let is_mobile = /Mobi/i.test(window.navigator.userAgent);

    if (is_mobile) {
      function scrollToSubject() {
        try {
          window.scrollTo({ top: 100, left: 0, behavior: 'smooth' });
        } catch (e) {}
      }

      scrollToSubject();
      window.addEventListener("orientationchange", function() {
        setTimeout(scrollToSubject, 100);
      });
    } else {
      document.getElementById('canvas').focus();
    }

    // Prevent default key behavior on the canvas
    const canvas = document.getElementById('canvas');
    canvas.addEventListener("keydown", function(ev) {
      ev.preventDefault();
      ev.stopPropagation();
    });

    // Refocus canvas when clicked
    canvas.addEventListener("click", function() {
      canvas.focus();
    });

    // Manage canvas focus state on mouse events
    document.addEventListener("mousedown", (function() {
      const canvasElement = document.getElementById('canvas');
      let focused = false;
      return function(ev) {
        if (ev.target == canvasElement) {
          if (!focused) {
            canvasElement.focus();
            focused = true;
          }
        } else if (focused) {
          focused = false;
        }
        return true;
      };
    })());

    // Import and initialize Waflash
    import { createWaflash } from 'https://cdn.jsdelivr.net/gh/zhit73/wafedit@183cb00916e4d250ae5bc9813864f9a70cb9986b/wasm/waflash-player.min.js';
    createWaflash(gameConfig.swfUrl, window.wafOptions || {});
  </script>

</body>
</html>
